<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe suppresses the console window on Windows; treated as a plain Exe elsewhere. A single
         net10.0 head for now — the Windows/Mac dual-head machinery Perch carries is deferred to M7. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Binoc.App</RootNamespace>
    <AssemblyName>binoc</AssemblyName>
    <Product>binoc</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe icon (Explorer, taskbar pin). Regenerate from binoc.svg with tools/gen-icons.ps1. -->
    <ApplicationIcon>Assets\binoc.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon assets, loaded at runtime via avares:// for the window icon (see MainWindow). -->
    <AvaloniaResource Include="Assets/**" />
    <!-- The changelog is embedded so the in-app "What's new" window can render it at runtime (read via
         the assembly manifest under the logical name "Binoc.CHANGELOG.md"). See ChangelogMarkdown. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Binoc.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <!-- Install / update. Wired in Program.Main from M0 (a no-op until installed); packaging lands at M7. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Binoc.Core\Binoc.Core.csproj" />
  </ItemGroup>
</Project>
